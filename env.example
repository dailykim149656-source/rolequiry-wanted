# Copy values into Vercel → rolequiry-wanted → Settings → Environment Variables.
# Production / Preview / Development 모두에 넣는 것을 권장.
# Do not commit real keys. .env* is gitignored.

# Hosted extractor / researcher / verifier. Luna-first.
ROLEQUIRY_EXTRACTOR_MODEL=gpt-5.6-luna
ROLEQUIRY_RESEARCH_MODEL=gpt-5.6-luna
ROLEQUIRY_VERIFIER_MODEL=gpt-5.6-luna
ROLEQUIRY_ESCALATION_MODEL=gpt-5.6-terra

# Optional. Only if a hosted OpenAI-compatible gateway is configured on the server.
# Do not invent a Rolequiry-specific key. Leave empty to keep the deterministic path.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Keep off in Wanted Edition production.
NEXT_PUBLIC_ROLEQUIRY_WEBMCP_SHIM=
